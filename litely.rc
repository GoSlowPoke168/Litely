#include <windows.h>
#include "resource.h"
IDI_LITELY ICON "assets/litely.ico"

// Controls are positioned in code at 96-dpi units; these templates only declare them.
200 DIALOGEX 0,0,260,90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Rename wallpaper"
FONT 10, "Segoe UI"
BEGIN
 EDITTEXT 201, 0, 0, 10, 10, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
 CONTROL "Save", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
 CONTROL "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
END

300 DIALOGEX 0,0,310,180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Import wallpaper"
FONT 10, "Segoe UI"
BEGIN
 AUTORADIOBUTTON "Original",301,0,0,10,10,WS_GROUP | WS_TABSTOP
 AUTORADIOBUTTON "1080p",302,0,0,10,10
 AUTORADIOBUTTON "720p",303,0,0,10,10
 AUTORADIOBUTTON "Original",305,0,0,10,10,WS_GROUP | WS_TABSTOP
 AUTORADIOBUTTON "30 fps",306,0,0,10,10
 CONTROL "Import",IDOK,"Button",BS_OWNERDRAW | WS_GROUP | WS_TABSTOP,0,0,10,10
 CONTROL "Cancel",IDCANCEL,"Button",BS_OWNERDRAW | WS_TABSTOP,0,0,10,10
END

310 DIALOGEX 0,0,270,83
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Remove wallpaper"
FONT 10,"Segoe UI"
BEGIN
 CONTROL "Remove",IDOK,"Button",BS_OWNERDRAW | WS_TABSTOP,0,0,10,10
 CONTROL "Cancel",IDCANCEL,"Button",BS_OWNERDRAW | WS_TABSTOP,0,0,10,10
END
